# 复制为 .env，权限设为 600。生产环境必须是 HTTPS 域名。
PUBLIC_ORIGIN=https://prompt.example.com
HOST=127.0.0.1
PORT=3080
# 新部署留空。仅在本机执行 --migrate-password-hash 时读取已有的旧版哈希。
PASSWORD_HASH=
# 仅在回环反代已覆盖可信客户端地址时开启。
TRUST_PROXY_CLIENT=false
# 可在登录后的“模型配置”页保存；首次使用时以下环境变量作为默认值。
# chat / responses / anthropic / gemini
MODEL_PROTOCOL=chat
# 基础地址应含版本路径，程序按协议追加调用路径
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=
MODEL_NAME=
# 仅本机开发可以设为 true，同时 PUBLIC_ORIGIN 必须是 localhost/127.0.0.1
ALLOW_INSECURE_LOCAL=false
# 管理员凭据、收藏、指引和模型配置加密存储。密钥用 node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))' 生成。
DATA_DIR=/var/lib/prompt-enhancer
STORAGE_KEY=
